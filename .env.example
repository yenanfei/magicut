# MagiCut cloud API — copy to .env on the GPU host and edit values.
MAGICUT_PIPELINE_MODE=auto
MAGICUT_API_HOST=0.0.0.0
MAGICUT_API_PORT=8080
MAGICUT_API_TOKEN=
MAGICUT_MAX_UPLOAD_MB=200
MAGICUT_DEFAULT_MAX_FRAMES=90
MAGICUT_JOB_TTL_HOURS=24
MAGICUT_CORS_ORIGINS=*
MAGICUT_DATA_DIR=./server_data
# MAGICUT_PUBLIC_HOST=magicut.example.com
